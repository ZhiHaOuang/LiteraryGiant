# Python cache and virtual environments
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
/build/
/dist/
.coverage
htmlcov/

# Local runtime state and logs (already tracked logs remain tracked).
/.literarygiant/
/logs/

# IDE files
.idea/

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Claude Code local-only state
/.claude/settings.local.json
/.claude/agent-memory-local/*
!/.claude/agent-memory-local/.gitkeep

# Canonical Library data is intentionally local-only and too large for watchers.
# Keep existing tracked .gitkeep files, but do not traverse the tree for new files.
/Library/

# Creative project workspaces. Track the reusable template, but keep actual
# project drafts, generated outputs, and run products out of git.
/Projects/**
!/Projects/
!/Projects/**/
!/Projects/**/.gitkeep
!/Projects/_template/**

# Legacy Yggdrasil layout. Kept ignored so old local data can remain in place
# without being migrated or accidentally committed.
/Yggdrasil/**
!/Yggdrasil/
!/Yggdrasil/**/
!/Yggdrasil/**/.gitkeep

# Legacy data root. New code should not write here, but ignore it if old
# commands accidentally recreate it.
/data/**

# Canonical model layout. Weight snapshots stay outside git.
# Existing tracked placeholders remain tracked without traversing this tree.
/models/

# Reproducible run outputs and metrics.
/runs/

# Backup of Library directory
/backup/

# Legacy state files from pre-canonical runs.
/retrieval_file/

# Temporary / debug / test scripts
/TempForTrain/
debug_*.py
test_fetch*.py

# Secrets and local environment files
.env
.env.*
*.secret
*secret*
*token*
*key*
scripts/api_env.sh

# Machine settings and private handoff artifacts stay outside public Git.
/.vscode/settings.json
/ReferenceLibrary/
/handoff-private/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm

# Vendored code includes legitimate key/token/secret test and implementation names.
!/dsh/
!/dsh/**
!/dsh-plugins/
!/dsh-plugins/**
# Machine dependencies and state remain local; child upstream ignore files also apply.
/.dsh-dev/
/dsh-plugins/node_modules/
/dsh-plugins/*/node_modules/
/dsh-plugins/*/node_modules
/experiments/**/node_modules
/dsh-plugins/*/lib/
!/dsh-plugins/dsh-ascii-sharks/lib/
!/dsh-plugins/dsh-ascii-sharks/lib/**
/dsh-plugins/*/runtime/
/dsh-plugins/*/native/target/
/dsh-plugins/*/.tmp/
/dsh-plugins/*/.debug/
/dsh-plugins/*/dist/
/dsh-plugins/*/*.tsbuildinfo
/dsh/**/.env
/dsh/**/.env.*
/dsh-plugins/**/.env
/dsh-plugins/**/.env.*
!/dsh/**/.env.*.example
!/dsh-plugins/**/.env.*.example
/dsh/**/*.p12
/dsh/**/*.pfx
/dsh-plugins/**/*.p12
/dsh-plugins/**/*.pfx
.DS_Store

# LG client bundles are rebuilt by dsh-plugins/scripts/build.mjs.
/dsh-plugins/lg-*/client.js

# Claude-style's LICENSE excludes these upstream assets from its MIT grant.
/dsh-plugins/dsh-claude-style/packages/assets/src/fonts/anthropic/
/dsh-plugins/dsh-claude-style/packages/assets/src/mascot/crab/
/dsh-plugins/dsh-claude-style/scripts/draw-crab.py
