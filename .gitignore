# Python cache and virtual environments
__pycache__/
*.py[cod]
.venv/

# IDE files
.idea/

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Claude Code local-only state
/.claude/settings.local.json
/.claude/agent-memory-local/*
!/.claude/agent-memory-local/.gitkeep

# Canonical Library layout. Track directory structure only; keep real source
# texts, extracted facts, indexes, ideas, and reference artifacts out of git.
/Library/**
!/Library/
!/Library/**/
!/Library/.gitkeep
!/Library/indexes/.gitkeep
!/Library/TaciturnRaw/.gitkeep
!/Library/TaciturnRaw/novels_raw/.gitkeep
!/Library/TaciturnRaw/stories_raw/.gitkeep
!/Library/TaciturnRaw/novels_cleaned/.gitkeep
!/Library/TaciturnRaw/stories_cleaned/.gitkeep
!/Library/TaciturnRaw/novels_chapter/.gitkeep
!/Library/Bridges/.gitkeep
!/Library/Bridges/novels_plot/.gitkeep
!/Library/Bridges/stories_plot/.gitkeep
!/Library/AbstractLibrary/.gitkeep
!/Library/AbstractLibrary/Worldview/.gitkeep
!/Library/AbstractLibrary/EventsLibrary/.gitkeep
!/Library/AbstractLibrary/CharacterArc/.gitkeep
!/Library/AbstractLibrary/EmotionRhythm/.gitkeep
!/Library/AbstractLibrary/Payoff_Angst/.gitkeep
!/Library/AbstractLibrary/Memes/.gitkeep
!/Library/AbstractLibrary/BookLogicGraph/.gitkeep

# Creative project workspaces. Track the reusable template, but keep actual
# project drafts, generated outputs, and run products out of git.
/Projects/**
!/Projects/
!/Projects/**/
!/Projects/**/.gitkeep
!/Projects/_template/**

# Legacy Yggdrasil layout. Kept ignored so old local data can remain in place
# without being migrated or accidentally committed.
/Yggdrasil/**
!/Yggdrasil/
!/Yggdrasil/**/
!/Yggdrasil/**/.gitkeep

# Legacy data root. New code should not write here, but ignore it if old
# commands accidentally recreate it.
/data/**

# Canonical model layout. Weight snapshots stay outside git.
/models/**
!/models/
!/models/**/
!/models/**/.gitkeep

# Reproducible run outputs and metrics.
/runs/**
!/runs/
!/runs/**/
!/runs/**/.gitkeep

# Backup of Library directory
/backup/

# Legacy state files from pre-canonical runs.
/retrieval_file/

# Temporary / debug / test scripts
/TempForTrain/
debug_*.py
test_fetch*.py

# Secrets and local environment files
.env
.env.*
*.secret
*secret*
*token*
*key*
