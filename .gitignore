# Python cache and virtual environments
__pycache__/
*.py[cod]
.venv/

# IDE files
.idea/

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Claude Code local-only state
/.claude/settings.local.json
/.claude/agent-memory-local/*
!/.claude/agent-memory-local/.gitkeep

# Canonical Library data is intentionally local-only and too large for watchers.
# Keep existing tracked .gitkeep files, but do not traverse the tree for new files.
/Library/

# Creative project workspaces. Track the reusable template, but keep actual
# project drafts, generated outputs, and run products out of git.
/Projects/**
!/Projects/
!/Projects/**/
!/Projects/**/.gitkeep
!/Projects/_template/**

# Legacy Yggdrasil layout. Kept ignored so old local data can remain in place
# without being migrated or accidentally committed.
/Yggdrasil/**
!/Yggdrasil/
!/Yggdrasil/**/
!/Yggdrasil/**/.gitkeep

# Legacy data root. New code should not write here, but ignore it if old
# commands accidentally recreate it.
/data/**

# Canonical model layout. Weight snapshots stay outside git.
/models/**
!/models/
!/models/**/
!/models/**/.gitkeep

# Reproducible run outputs and metrics.
/runs/**
!/runs/
!/runs/**/
!/runs/**/.gitkeep

# Backup of Library directory
/backup/

# Legacy state files from pre-canonical runs.
/retrieval_file/

# Temporary / debug / test scripts
/TempForTrain/
debug_*.py
test_fetch*.py

# Secrets and local environment files
.env
.env.*
*.secret
*secret*
*token*
*key*
scripts/api_env.sh
