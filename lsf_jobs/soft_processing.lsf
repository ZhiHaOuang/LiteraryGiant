#!/bin/bash
#BSUB -J seg2vec
#BSUB -q 8v100-32-sc
#BSUB -n 2
#BSUB -W 08:00
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=16000]"
#BSUB -gpu "num=2:mode=exclusive_process:mps=yes:j_exclusive=yes"
#BSUB -o runs/logs/%J.out
#BSUB -e runs/logs/%J.err

set -euo pipefail

mkdir -p runs/logs

echo "Running on $(hostname)"
echo "Using ${LSB_DJOB_NUMPROC:-0} cores"
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}"
echo "LSB_GPU_IDS=${LSB_GPU_IDS:-unset}"
echo "LSB_GPU_DEVICES=${LSB_GPU_DEVICES:-unset}"

PROJECT_ROOT="${PROJECT_ROOT:-${LS_SUBCWD:-$PWD}}"
INPUT_PATH="${INPUT_PATH:-$PROJECT_ROOT/Yggdrasil/derived/chapters}"
OUTPUT_ROOT="${OUTPUT_ROOT:-$PROJECT_ROOT/Yggdrasil/derived/features}"
WEIGHTS_ROOT="${WEIGHTS_ROOT:-$PROJECT_ROOT/models/weights}"
NUEXTRACT_MODEL="${NUEXTRACT_MODEL:-}"
NUEXTRACT_SIZE="${NUEXTRACT_SIZE:-4b}"
NUEXTRACT_MAX_INPUT_CHARS="${NUEXTRACT_MAX_INPUT_CHARS:-6000}"
NUEXTRACT_MAX_NEW_TOKENS="${NUEXTRACT_MAX_NEW_TOKENS:-1024}"
DEVICE_MAP="${DEVICE_MAP:-auto}"
COMPACT_OUTPUT="${COMPACT_OUTPUT:-0}"
CONDA_ENV_NAME="${CONDA_ENV_NAME:-LitCodex}"
SYNC_PIPELINE_STATE="${SYNC_PIPELINE_STATE:-0}"

# Prefer LSF-assigned GPU IDs when available
if [ -n "${LSB_GPU_IDS:-}" ]; then
  export CUDA_VISIBLE_DEVICES="${LSB_GPU_IDS}"
  echo "CUDA_VISIBLE_DEVICES set from LSB_GPU_IDS=${LSB_GPU_IDS}"
elif [ -n "${LSB_GPU_DEVICES:-}" ]; then
  export CUDA_VISIBLE_DEVICES="${LSB_GPU_DEVICES}"
  echo "CUDA_VISIBLE_DEVICES set from LSB_GPU_DEVICES=${LSB_GPU_DEVICES}"
elif [ -z "${CUDA_VISIBLE_DEVICES:-}" ]; then
  export CUDA_VISIBLE_DEVICES=0,1
  echo "CUDA_VISIBLE_DEVICES was empty; set to 0,1"
fi

export CUDA_DEVICE_ORDER=PCI_BUS_ID
export TOKENIZERS_PARALLELISM=false
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "PROJECT_ROOT=$PROJECT_ROOT"
echo "INPUT_PATH=$INPUT_PATH"
echo "OUTPUT_ROOT=$OUTPUT_ROOT"
echo "WEIGHTS_ROOT=$WEIGHTS_ROOT"
echo "NUEXTRACT_MODEL=$NUEXTRACT_MODEL"
echo "NUEXTRACT_SIZE=$NUEXTRACT_SIZE"
echo "NUEXTRACT_MAX_INPUT_CHARS=$NUEXTRACT_MAX_INPUT_CHARS"
echo "NUEXTRACT_MAX_NEW_TOKENS=$NUEXTRACT_MAX_NEW_TOKENS"
echo "DEVICE_MAP=$DEVICE_MAP"
echo "CONDA_ENV_NAME=$CONDA_ENV_NAME"
echo "SYNC_PIPELINE_STATE=$SYNC_PIPELINE_STATE"

cd "$PROJECT_ROOT"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"

nvidia-smi || true
date

module load python/anaconda3/2022.10
module load cuda/12.4

eval "$(conda shell.bash hook)"

if conda env list | awk '{print $1}' | grep -qx "$CONDA_ENV_NAME"; then
  conda activate "$CONDA_ENV_NAME"
elif [[ -f ".venv/bin/activate" ]]; then
  source .venv/bin/activate
else
  echo "No conda env named $CONDA_ENV_NAME and no .venv found." >&2
  exit 1
fi

python - <<'PY'
import torch
import transformers
print("torch_version=", torch.__version__)
print("torch_cuda_build=", torch.version.cuda)
print("transformers_version=", transformers.__version__)
print("cuda_available=", torch.cuda.is_available())
print("cuda_device_count=", torch.cuda.device_count())
PY

mkdir -p "$OUTPUT_ROOT"

mapfile -t BOOK_DIRS < <(python - <<'PY' "$INPUT_PATH"
from pathlib import Path
import sys

path = Path(sys.argv[1]).expanduser()
if not path.exists():
    raise SystemExit(f"Input path does not exist: {path}")

if path.is_dir() and (path / "index.json").exists():
    print(path)
elif path.is_dir():
    for item in sorted(path.iterdir()):
        if item.is_dir() and (item / "index.json").exists():
            print(item)
else:
    raise SystemExit(f"Input path must be a canonical chapters root or one processed book directory: {path}")
PY
)

if [[ "${#BOOK_DIRS[@]}" -eq 0 ]]; then
  echo "No processed book directories found under $INPUT_PATH" >&2
  exit 1
fi

IFS=',' read -r -a GPU_IDS <<< "${CUDA_VISIBLE_DEVICES:-0}"
if [[ "${#GPU_IDS[@]}" -eq 0 ]]; then
  GPU_IDS=(0)
fi

GPU_COUNT="${#GPU_IDS[@]}"
BOOK_COUNT="${#BOOK_DIRS[@]}"
WORKER_COUNT=$(( GPU_COUNT < BOOK_COUNT ? GPU_COUNT : BOOK_COUNT ))

if [[ "$SYNC_PIPELINE_STATE" == "1" && "$WORKER_COUNT" -gt 1 ]]; then
  echo "SYNC_PIPELINE_STATE=1 detected. For correctness, forcing single-worker mode to avoid concurrent writes to runs/pipeline_state/state.json."
  WORKER_COUNT=1
fi

echo "Detected $GPU_COUNT allocated GPU(s): ${GPU_IDS[*]}"
echo "Discovered $BOOK_COUNT processed book(s)"
echo "Launching $WORKER_COUNT parallel worker(s) without lowering quality settings"

run_one_book() {
  local gpu_id="$1"
  local book_dir="$2"
  local -a cmd=(
  python -m softmodel "$book_dir"
  -o "$OUTPUT_ROOT"
  --weights-root "$WEIGHTS_ROOT"
  --nuextract-model "$NUEXTRACT_MODEL"
  --nuextract-size "$NUEXTRACT_SIZE"
  --nuextract-max-input-chars "$NUEXTRACT_MAX_INPUT_CHARS"
  --nuextract-max-new-tokens "$NUEXTRACT_MAX_NEW_TOKENS"
  --device-map "$DEVICE_MAP"
  )

  if [[ "$COMPACT_OUTPUT" == "1" ]]; then
    cmd+=(--compact)
  fi

  if [[ "$SYNC_PIPELINE_STATE" == "0" ]]; then
    cmd+=(--no-sync-state)
  fi

  echo "[WORKER gpu=$gpu_id] Executing for $(basename "$book_dir"):"
  printf '  %q' "${cmd[@]}"
  printf '\n'

  CUDA_VISIBLE_DEVICES="$gpu_id" "${cmd[@]}"
}

worker() {
  local worker_index="$1"
  local gpu_id="${GPU_IDS[$worker_index]}"
  local book_index
  for (( book_index=worker_index; book_index<BOOK_COUNT; book_index+=WORKER_COUNT )); do
    run_one_book "$gpu_id" "${BOOK_DIRS[$book_index]}"
  done
}

declare -a WORKER_PIDS=()
for (( worker_index=0; worker_index<WORKER_COUNT; worker_index++ )); do
  worker "$worker_index" &
  WORKER_PIDS+=("$!")
done

overall_status=0
for pid in "${WORKER_PIDS[@]}"; do
  if ! wait "$pid"; then
    overall_status=1
  fi
done

exit "$overall_status"
