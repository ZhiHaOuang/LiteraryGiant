#!/bin/bash
#BSUB -J plotgen
#BSUB -q 8v100-32-sc
#BSUB -n 5
#BSUB -W 08:00
#BSUB -R "rusage[mem=32000]"
#BSUB -gpu "num=5:mode=exclusive_process:mps=yes:j_exclusive=yes"
#BSUB -o runs/logs/%J.out
#BSUB -e runs/logs/%J.err

set -euo pipefail

mkdir -p runs/logs

echo "Running on $(hostname)"
echo "Using ${LSB_DJOB_NUMPROC:-0} cores"
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}"
echo "LSB_GPU_IDS=${LSB_GPU_IDS:-unset}"
echo "LSB_GPU_DEVICES=${LSB_GPU_DEVICES:-unset}"

PROJECT_ROOT="${PROJECT_ROOT:-${LS_SUBCWD:-$PWD}}"
INPUT_PATH="${INPUT_PATH:-$PROJECT_ROOT/Yggdrasil/derived/plots}"
FEATURE_ROOT="${FEATURE_ROOT:-$PROJECT_ROOT/Yggdrasil/derived/features}"
OUTPUT_ROOT="${OUTPUT_ROOT:-$PROJECT_ROOT/Yggdrasil/derived/generations}"
WEIGHTS_ROOT="${WEIGHTS_ROOT:-$PROJECT_ROOT/models/weights}"
TARGET_BOOK_ID="${TARGET_BOOK_ID:-}"
GENERATOR_MODEL="${GENERATOR_MODEL:-}"
GENERATOR_SIZE="${GENERATOR_SIZE:-14b}"
GENERATOR_FAMILY_DIRS="${GENERATOR_FAMILY_DIRS:-Qwen,qwen,QWEN}"
CRITIC_MODEL="${CRITIC_MODEL:-}"
CRITIC_SIZE="${CRITIC_SIZE:-14b}"
CRITIC_FAMILY_DIRS="${CRITIC_FAMILY_DIRS:-DeepSeek,deepseek,DEEPSEEK}"
SEED_PLOT_COUNT="${SEED_PLOT_COUNT:-3}"
GENERATION_COUNT="${GENERATION_COUNT:-1}"
TARGET_CHAPTER_COUNT="${TARGET_CHAPTER_COUNT:-}"
MIN_TARGET_CHAPTERS="${MIN_TARGET_CHAPTERS:-4}"
MAX_TARGET_CHAPTERS="${MAX_TARGET_CHAPTERS:-12}"
MAX_REVISION_ROUNDS="${MAX_REVISION_ROUNDS:-2}"
MAX_NEW_TOKENS="${MAX_NEW_TOKENS:-2200}"
DEVICE_MAP="${DEVICE_MAP:-auto}"
GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-0.9}"
PER_GPU_MEMORY_GB="${PER_GPU_MEMORY_GB:-}"
ALLOW_FALLBACK="${ALLOW_FALLBACK:-0}"
RANDOM_SEED="${RANDOM_SEED:-}"
COMPACT_OUTPUT="${COMPACT_OUTPUT:-0}"
CONDA_ENV_NAME="${CONDA_ENV_NAME:-LitCodex}"

if [ -n "${LSB_GPU_IDS:-}" ]; then
  export CUDA_VISIBLE_DEVICES="${LSB_GPU_IDS}"
  echo "CUDA_VISIBLE_DEVICES set from LSB_GPU_IDS=${LSB_GPU_IDS}"
elif [ -n "${LSB_GPU_DEVICES:-}" ]; then
  export CUDA_VISIBLE_DEVICES="${LSB_GPU_DEVICES}"
  echo "CUDA_VISIBLE_DEVICES set from LSB_GPU_DEVICES=${LSB_GPU_DEVICES}"
elif [ -z "${CUDA_VISIBLE_DEVICES:-}" ]; then
  export CUDA_VISIBLE_DEVICES=0,1
  echo "CUDA_VISIBLE_DEVICES was empty; set to 0,1"
fi

export CUDA_DEVICE_ORDER=PCI_BUS_ID
export TOKENIZERS_PARALLELISM=false
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "PROJECT_ROOT=$PROJECT_ROOT"
echo "INPUT_PATH=$INPUT_PATH"
echo "FEATURE_ROOT=$FEATURE_ROOT"
echo "OUTPUT_ROOT=$OUTPUT_ROOT"
echo "WEIGHTS_ROOT=$WEIGHTS_ROOT"
echo "TARGET_BOOK_ID=${TARGET_BOOK_ID:-unset}"
echo "GENERATOR_MODEL=${GENERATOR_MODEL:-unset}"
echo "GENERATOR_SIZE=$GENERATOR_SIZE"
echo "GENERATOR_FAMILY_DIRS=$GENERATOR_FAMILY_DIRS"
echo "CRITIC_MODEL=${CRITIC_MODEL:-unset}"
echo "CRITIC_SIZE=$CRITIC_SIZE"
echo "CRITIC_FAMILY_DIRS=$CRITIC_FAMILY_DIRS"
echo "SEED_PLOT_COUNT=$SEED_PLOT_COUNT"
echo "GENERATION_COUNT=$GENERATION_COUNT"
echo "TARGET_CHAPTER_COUNT=${TARGET_CHAPTER_COUNT:-unset}"
echo "MIN_TARGET_CHAPTERS=$MIN_TARGET_CHAPTERS"
echo "MAX_TARGET_CHAPTERS=$MAX_TARGET_CHAPTERS"
echo "MAX_REVISION_ROUNDS=$MAX_REVISION_ROUNDS"
echo "MAX_NEW_TOKENS=$MAX_NEW_TOKENS"
echo "DEVICE_MAP=$DEVICE_MAP"
echo "GPU_MEMORY_UTILIZATION=$GPU_MEMORY_UTILIZATION"
echo "PER_GPU_MEMORY_GB=${PER_GPU_MEMORY_GB:-unset}"
echo "ALLOW_FALLBACK=$ALLOW_FALLBACK"
echo "RANDOM_SEED=${RANDOM_SEED:-unset}"
echo "CONDA_ENV_NAME=$CONDA_ENV_NAME"

cd "$PROJECT_ROOT"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"

nvidia-smi || true
date

module load python/anaconda3/2022.10
module load cuda/12.4

eval "$(conda shell.bash hook)"

if conda env list | awk '{print $1}' | grep -qx "$CONDA_ENV_NAME"; then
  conda activate "$CONDA_ENV_NAME"
elif [[ -f ".venv/bin/activate" ]]; then
  source .venv/bin/activate
else
  echo "No conda env named $CONDA_ENV_NAME and no .venv found." >&2
  exit 1
fi

python - <<'PY'
try:
    import torch
    print("torch_version=", torch.__version__)
    print("torch_cuda_build=", torch.version.cuda)
    print("cuda_available=", torch.cuda.is_available())
    print("cuda_device_count=", torch.cuda.device_count())
    if torch.cuda.is_available():
        for index in range(torch.cuda.device_count()):
            props = torch.cuda.get_device_properties(index)
            print(f"cuda_device_{index}_name=", props.name)
            print(f"cuda_device_{index}_total_memory_gb=", round(props.total_memory / (1024 ** 3), 2))
except Exception as exc:
    print("torch_check_failed=", repr(exc))

try:
    import transformers
    print("transformers_version=", transformers.__version__)
except Exception as exc:
    print("transformers_check_failed=", repr(exc))
PY

mkdir -p "$OUTPUT_ROOT"

cmd=(
  python -m generatemodel "$INPUT_PATH"
  --feature-root "$FEATURE_ROOT"
  --weights-root "$WEIGHTS_ROOT"
  -o "$OUTPUT_ROOT"
  --seed-plot-count "$SEED_PLOT_COUNT"
  --generation-count "$GENERATION_COUNT"
  --min-target-chapters "$MIN_TARGET_CHAPTERS"
  --max-target-chapters "$MAX_TARGET_CHAPTERS"
  --max-revision-rounds "$MAX_REVISION_ROUNDS"
  --max-new-tokens "$MAX_NEW_TOKENS"
  --device-map "$DEVICE_MAP"
  --gpu-memory-utilization "$GPU_MEMORY_UTILIZATION"
  --generator-family-dirs "$GENERATOR_FAMILY_DIRS"
  --critic-family-dirs "$CRITIC_FAMILY_DIRS"
)

if [[ -n "$TARGET_BOOK_ID" ]]; then
  cmd+=(--target-book-id "$TARGET_BOOK_ID")
fi

if [[ -n "$GENERATOR_MODEL" ]]; then
  cmd+=(--generator-model "$GENERATOR_MODEL")
else
  cmd+=(--generator-size "$GENERATOR_SIZE")
fi

if [[ -n "$CRITIC_MODEL" ]]; then
  cmd+=(--critic-model "$CRITIC_MODEL")
else
  cmd+=(--critic-size "$CRITIC_SIZE")
fi

if [[ -n "$TARGET_CHAPTER_COUNT" ]]; then
  cmd+=(--target-chapter-count "$TARGET_CHAPTER_COUNT")
fi

if [[ -n "$PER_GPU_MEMORY_GB" ]]; then
  cmd+=(--per-gpu-memory-gb "$PER_GPU_MEMORY_GB")
fi

if [[ -n "$RANDOM_SEED" ]]; then
  cmd+=(--random-seed "$RANDOM_SEED")
fi

if [[ "$ALLOW_FALLBACK" == "1" ]]; then
  cmd+=(--allow-fallback)
else
  cmd+=(--strict-local-models)
fi

if [[ "$COMPACT_OUTPUT" == "1" ]]; then
  cmd+=(--compact)
fi

echo "Executing:"
printf '  %q' "${cmd[@]}"
printf '\n'

"${cmd[@]}"
