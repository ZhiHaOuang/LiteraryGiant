#!/bin/bash
#BSUB -J preprocess
#BSUB -q 63
#BSUB -n 4
#BSUB -W 04:00
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=4000]"
#BSUB -o runs/logs/%J.out
#BSUB -e runs/logs/%J.err

set -euo pipefail

echo "Running on $(hostname)"
echo "Using $LSB_DJOB_NUMPROC cores"

PROJECT_ROOT="${PROJECT_ROOT:-$HOME/LiteraryGiant}"
INPUT_PATH="${INPUT_PATH:-$PROJECT_ROOT/Yggdrasil/sources/imports}"
OUTPUT_ROOT="${OUTPUT_ROOT:-$PROJECT_ROOT/Yggdrasil/sources/raw_text}"
RETRIEVAL_ROOT="${RETRIEVAL_ROOT:-$PROJECT_ROOT/runs/retrieval_state}"
TARGET_ENCODING="${TARGET_ENCODING:-utf-8}"
WIDTH="${WIDTH:-4}"

echo "PROJECT_ROOT=$PROJECT_ROOT"
echo "INPUT_PATH=$INPUT_PATH"
echo "OUTPUT_ROOT=$OUTPUT_ROOT"
echo "RETRIEVAL_ROOT=$RETRIEVAL_ROOT"
echo "TARGET_ENCODING=$TARGET_ENCODING"
echo "WIDTH=$WIDTH"

cd "$PROJECT_ROOT"

module load python/anaconda3/2022.10

if command -v conda >/dev/null 2>&1; then
  eval "$(conda shell.bash hook)"
  if conda env list | awk '{print $1}' | grep -qx "LitCodex"; then
    conda activate LitCodex
  elif [[ -f ".venv/bin/activate" ]]; then
    source .venv/bin/activate
  else
    echo "No conda env named LitCodex and no .venv found." >&2
    exit 1
  fi
elif [[ -f ".venv/bin/activate" ]]; then
  source .venv/bin/activate
else
  echo "Conda is unavailable and .venv/bin/activate was not found." >&2
  exit 1
fi

mkdir -p "$OUTPUT_ROOT" "$RETRIEVAL_ROOT"

cmd=(
  python3 scripts/rename.py
  -i "$INPUT_PATH"
  -o "$OUTPUT_ROOT"
  -r "$RETRIEVAL_ROOT"
  --target-encoding "$TARGET_ENCODING"
  --width "$WIDTH"
)

echo "Executing:"
printf '  %q' "${cmd[@]}"
printf '\n'

"${cmd[@]}"
