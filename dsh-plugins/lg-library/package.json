{
  "name": "lg-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bounded literary reference retrieval with verifiable citations",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "src",
    "cordis.patch.yml",
    "README.md",
    "client.js"
  ],
  "engines": {
    "node": ">=24.9",
    "dsh": ">=0.2.2-rc.1 <0.2.3-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/schemastery": "~3.19.0",
    "lg-books": "0.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
