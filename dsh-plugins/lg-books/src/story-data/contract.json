{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://literarygiant.local/contracts/story-data/1.1.0",
  "title": "LG 书级故事记录 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "type": {
      "enum": [
        "entity",
        "world_rule",
        "scene",
        "event",
        "state",
        "relation",
        "knowledge",
        "revelation",
        "thread",
        "plan",
        "portrait",
        "analysis",
        "requirement",
        "role_assignment"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "短语或名称，不拼接多个无关信息。"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800,
      "description": "完整中文句子，说明一个明确判断；不写 Markdown 标题。"
    },
    "basis": {
      "enum": [
        "text",
        "character_statement",
        "inference",
        "author"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "book",
            "chapter",
            "scene",
            "entity",
            "region",
            "arc"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "完整中文句子，说明一个明确判断；不写 Markdown 标题。"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 20
        }
      },
      "required": [
        "kind",
        "description",
        "targets"
      ]
    },
    "story_time": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "all",
            "unknown",
            "relative",
            "interval",
            "range"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200,
          "description": "完整中文句子，说明一个明确判断；不写 Markdown 标题。"
        },
        "after_event": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "before_event": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "coordinate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "axis": {
              "$ref": "#/$defs/id"
            },
            "unit": {
              "enum": [
                "minute",
                "hour",
                "day"
              ]
            },
            "start_min": {
              "type": "number",
              "minimum": -1000000000,
              "maximum": 1000000000
            },
            "start_max": {
              "type": "number",
              "minimum": -1000000000,
              "maximum": 1000000000
            },
            "end_min": {
              "type": "number",
              "minimum": -1000000000,
              "maximum": 1000000000
            },
            "end_max": {
              "type": "number",
              "minimum": -1000000000,
              "maximum": 1000000000
            }
          },
          "required": [
            "axis",
            "unit",
            "start_min",
            "start_max",
            "end_min",
            "end_max"
          ]
        },
        "offset": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "anchor_event": {
              "$ref": "#/$defs/id"
            },
            "anchor_point": {
              "enum": [
                "start",
                "end"
              ]
            },
            "min": {
              "type": "number",
              "minimum": -1000000000,
              "maximum": 1000000000
            },
            "max": {
              "type": "number",
              "minimum": -1000000000,
              "maximum": 1000000000
            },
            "unit": {
              "enum": [
                "minute",
                "hour",
                "day"
              ]
            }
          },
          "required": [
            "anchor_event",
            "anchor_point",
            "min",
            "max",
            "unit"
          ]
        }
      },
      "required": [
        "kind",
        "label",
        "after_event",
        "before_event"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "document_id": {
            "type": "integer",
            "minimum": 1
          },
          "version_id": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "paragraph": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "type": "string",
            "minLength": 4,
            "maxLength": 500,
            "description": "指定段落中逐字存在的原文，不允许省略号改写。"
          }
        },
        "required": [
          "document_id",
          "version_id",
          "sha256",
          "paragraph",
          "quote"
        ]
      },
      "maxItems": 16
    },
    "author_note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 800,
      "description": "完整中文句子，说明一个明确判断；不写 Markdown 标题。"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "relation": {
            "enum": [
              "before",
              "causes",
              "enables",
              "obstructs",
              "supports",
              "contradicts",
              "reveals",
              "pays_off",
              "part_of",
              "motivates",
              "simultaneous",
              "overlaps"
            ]
          },
          "target": {
            "$ref": "#/$defs/id"
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "完整中文句子，说明一个明确判断；不写 Markdown 标题。"
          }
        },
        "required": [
          "relation",
          "target",
          "explanation"
        ]
      },
      "maxItems": 24
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "summary",
    "basis",
    "scope",
    "story_time",
    "evidence",
    "author_note",
    "links",
    "payload"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "entity"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/entity"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "world_rule"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/world_rule"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "scene"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/scene"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "event"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/event"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "state"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/state"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "relation"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/relation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "knowledge"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/knowledge"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "revelation"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/revelation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "thread"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/thread"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "plan"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/plan"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "portrait"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/portrait"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "analysis"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/analysis"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "requirement"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/requirement"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "role_assignment"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/role_assignment"
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9:_-]{0,119}$",
      "description": "作品内稳定 ID；引用同一实体必须复用 ID。"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "type": "integer",
          "minimum": 1
        },
        "version_id": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "paragraph": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 4,
          "maxLength": 500,
          "description": "指定段落中逐字存在的原文，不允许省略号改写。"
        }
      },
      "required": [
        "document_id",
        "version_id",
        "sha256",
        "paragraph",
        "quote"
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_kind": {
          "enum": [
