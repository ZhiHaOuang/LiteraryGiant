        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "短语或名称，不拼接多个无关信息。"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "短语或名称，不拼接多个无关信息。"
          },
          "maxItems": 20
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800,
          "description": "完整中文句子，说明一个明确判断；不写 Markdown 标题。"
        }
      },
      "required": [
        "entity_kind",
        "name",
        "aliases",
        "description"
      ]
